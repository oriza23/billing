# Salin sebagai .env.local untuk menimpa nilai bawaan (file *.local tidak ikut git).
# Urutan prioritas Vite: .env.local > .env.[mode].local > .env.[mode] > .env
#
# VITE_API_URL = origin backend tanpa "/api".
#   (tidak ada)                -> dev: http://<host halaman>:5000, produksi: relative path
#   VITE_API_URL=              -> relative path (disarankan produksi)
#   VITE_API_URL=http://localhost:5000
#
# Variabel VITE_* tertanam di hasil build dan terlihat publik. Jangan isi secret/token di sini.
VITE_API_URL=

# Nomor WhatsApp admin (internasional tanpa +), untuk tombol di halaman /isolir.
# VITE_WA_ADMIN=6281234567890
