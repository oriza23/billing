# Salin ke .env di akar proyek (install.sh membuat ini otomatis).
# Jangan commit .env ke git.

PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=oriza
DB_PASSWORD=ganti_password_kuat
DB_NAME=orizabil
DB_SERVICE=postgresql

JWT_SECRET=isi_hex_acak_panjang
JWT_EXPIRES_IN=12h

# Superadmin awal (dipakai install.sh + scripts/setup-admin.js)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ganti_password_admin
SETUP_ADMIN_NAMA_LENGKAP=Nama Lengkap Admin
SETUP_ADMIN_EMAIL=admin@contoh.com

# Set 1 bila di belakang Nginx (default install.sh) atau Cloudflare
# TRUST_PROXY=1

# Batasi origin API (dipisah koma). Kosong = semua origin diizinkan.
# CORS_ORIGINS=https://billing.contoh.id,http://localhost:5173

# Token opsional untuk membuka detail GET /healthz (monitoring). Tanpa ini,
# /healthz tetap publik tetapi hanya membalas status ok/degraded.
# Buat dengan: openssl rand -hex 24
# HEALTH_TOKEN=

# Sinkron router -> tabel nas FreeRADIUS (lihat docs/MULTI_NAS.md).
# 1 = restart FreeRADIUS otomatis setelah daftar router berubah (butuh hak systemctl).
# FREERADIUS_RESTART_ON_SYNC=1
# FREERADIUS_SERVICE=freeradius
