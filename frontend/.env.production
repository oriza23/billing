# Dipakai otomatis oleh `npm run build` (mode production).
# Kosong = relative path: request ke "/api/..." mengikuti domain & protokol yang sedang dibuka
# (https://billing.domainanda.com -> https://billing.domainanda.com/api/...), jadi tidak ada Mixed Content.
# Cocok untuk VPS (backend menyajikan dist) maupun Cloudflare Tunnel.
VITE_API_URL=
