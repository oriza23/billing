# Salin ke scripts/.env.migrate lalu isi (chmod 600). Jangan commit.
#
# Sumber (MariaDB — server yang sedang jalan)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=oriza
MYSQL_PASSWORD=ganti
MYSQL_DATABASE=orizabil

# Tujuan (PostgreSQL — akan dibuat jika belum ada)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=oriza
PG_PASSWORD=ganti_password_baru
PG_DATABASE=orizabil

# Billing (.env di akar proyek) — setelah migrasi
APP_DIR=/var/www/billing