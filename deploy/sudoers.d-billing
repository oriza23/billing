billing ALL=(root) NOPASSWD: \
  /usr/bin/systemctl restart postgresql, \
  /usr/bin/systemctl restart freeradius, \
  /usr/bin/timedatectl set-timezone *, \
  /usr/bin/ln -sfn /usr/share/zoneinfo/* /etc/localtime, \
  /usr/bin/install -m 0644 * /etc/timezone, \
  /usr/bin/systemctl enable --now wg-quick@wg-billing, \
  /usr/bin/systemctl restart wg-quick@wg-billing, \
  /usr/bin/systemctl disable --now wg-quick@wg-billing, \
  /usr/bin/systemctl enable --now openvpn-client@raniah-vpn, \
  /usr/bin/systemctl restart openvpn-client@raniah-vpn, \
  /usr/bin/systemctl disable --now openvpn-client@raniah-vpn, \
  /usr/bin/systemctl enable --now raniah-sstp, \
  /usr/bin/systemctl restart raniah-sstp, \
  /usr/bin/systemctl disable --now raniah-sstp, \
  /usr/bin/systemctl enable --now raniah-l2tp, \
  /usr/bin/systemctl restart raniah-l2tp, \
  /usr/bin/systemctl disable --now raniah-l2tp, \
  /usr/bin/systemctl disable --now xl2tpd, \
  /usr/bin/systemctl reset-failed wg-quick@wg-billing, \
  /usr/bin/systemctl reset-failed openvpn-client@raniah-vpn, \
  /usr/bin/systemctl reset-failed raniah-sstp, \
  /usr/bin/systemctl reset-failed raniah-l2tp, \
  /usr/bin/systemctl reset-failed xl2tpd, \
  /usr/bin/wg show wg-billing dump, \
  /usr/bin/journalctl -u wg-quick@wg-billing -n 10 --no-pager, \
  /usr/bin/journalctl -u openvpn-client@raniah-vpn -n 10 --no-pager, \
  /usr/bin/journalctl -u raniah-sstp -n 20 --no-pager, \
  /usr/bin/journalctl -u raniah-l2tp -u xl2tpd -n 20 --no-pager, \
  /usr/local/sbin/raniah-vpn-helper apply, \
  /usr/local/sbin/raniah-vpn-helper cycle wireguard stop, \
  /usr/local/sbin/raniah-vpn-helper cycle wireguard start, \
  /usr/local/sbin/raniah-vpn-helper cycle wireguard restart, \
  /usr/local/sbin/raniah-vpn-helper cycle wireguard disable, \
  /usr/local/sbin/raniah-vpn-helper cycle openvpn stop, \
  /usr/local/sbin/raniah-vpn-helper cycle openvpn start, \
  /usr/local/sbin/raniah-vpn-helper cycle openvpn restart, \
  /usr/local/sbin/raniah-vpn-helper cycle openvpn disable, \
  /usr/local/sbin/raniah-vpn-helper cycle sstp stop, \
  /usr/local/sbin/raniah-vpn-helper cycle sstp start, \
  /usr/local/sbin/raniah-vpn-helper cycle sstp restart, \
  /usr/local/sbin/raniah-vpn-helper cycle sstp disable, \
  /usr/local/sbin/raniah-vpn-helper cycle l2tp stop, \
  /usr/local/sbin/raniah-vpn-helper cycle l2tp start, \
  /usr/local/sbin/raniah-vpn-helper cycle l2tp restart, \
  /usr/local/sbin/raniah-vpn-helper cycle l2tp disable
